{
  "name": "serverlab",
  "productName": "ServerLab",
  "version": "2.9.0",
  "private": true,
  "description": "Simulateur d'administration de serveurs (AD DS, DNS, DHCP, GPO, partages) pour réviser l'E6 du BTS SIO SISR",
  "author": "tamalou25",
  "license": "UNLICENSED",
  "homepage": "https://github.com/tamalou25/packetracer-windows",
  "desktopName": "serverlab.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixture:slab": "vitest run tests/engine/serialization/fixture-write.test.ts --mode fixture",
    "perf:measure": "vitest run tests/engine/perf/measure.test.ts --mode perf",
    "test:e2e": "electron-vite build && playwright test",
    "icon": "node scripts/build-icon.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.63",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
